# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=alzheimers

# Flask (UI + API on the same port)
FLASK_PORT=5000
FLASK_DEBUG=1
FLASK_USE_RELOADER=0
FLASK_SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# PyTorch model (use absolute path on Windows host; Docker overrides to /app/models/model.pth)
MODEL_PATH=./models/model.pth

# Email (optional — for AI report delivery)
# Local Docker: use Mailpit (host mailpit, port 1025, STARTTLS=0)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SMTP_STARTTLS=1
EMAIL_SMTP_SSL=0
